diff --git a/rootdir/Android.bp b/rootdir/Android.bp
new file mode 100644
--- /dev/null
+++ b/rootdir/Android.bp
@@ -0,0 +1,25 @@
+// Preserve the /etc paths used by the old GPS binaries while storing vendor
+// configuration under /vendor/etc with the existing vendor_configs_file label.
+install_symlink {
+    name: "msm8974_gps_conf_legacy_link",
+    installed_location: "etc/gps.conf",
+    symlink_target: "/vendor/etc/gps.conf",
+}
+
+install_symlink {
+    name: "msm8974_flp_conf_legacy_link",
+    installed_location: "etc/flp.conf",
+    symlink_target: "/vendor/etc/flp.conf",
+}
+
+install_symlink {
+    name: "msm8974_izat_conf_legacy_link",
+    installed_location: "etc/izat.conf",
+    symlink_target: "/vendor/etc/izat.conf",
+}
+
+install_symlink {
+    name: "msm8974_sap_conf_legacy_link",
+    installed_location: "etc/sap.conf",
+    symlink_target: "/vendor/etc/sap.conf",
+}
