diff --git a/sepolicy/bdaddr.te b/sepolicy/bdaddr.te
--- a/sepolicy/bdaddr.te
+++ b/sepolicy/bdaddr.te
@@ -1,5 +1,5 @@
 type bdaddr, domain;
-type bdaddr_exec, exec_type, file_type;
+type bdaddr_exec, exec_type, vendor_file_type, file_type;
 
 init_daemon_domain(bdaddr)
 
@@ -15,3 +15,16 @@
 allow bdaddr self:capability { fsetid dac_override };
 
 allow bdaddr smem_log_device:chr_file rw_file_perms;
+
+# The hciattach shell runs as the existing firmware-loader domain. Running it
+# as the generic QTI init shell prevents execution of hci_qcomm_init entirely.
+typeattribute bluetooth_loader_exec vendor_file_type;
+domain_trans(init, vendor_shell_exec, bluetooth_loader)
+allow bluetooth_loader vendor_shell_exec:file rx_file_perms;
+allow bluetooth_loader qti_init_shell_exec:file r_file_perms;
+allow bluetooth_loader bluetooth_loader_exec:file rx_file_perms;
+allow bluetooth_loader vendor_toolbox_exec:file rx_file_perms;
+r_dir_file(bluetooth_loader, bluetooth_data_file)
+# The passthrough HAL opens only the two HCI channels labeled by this device.
+allow bluetooth hci_attach_dev:chr_file rw_file_perms;
+allow bluetooth_loader hci_attach_dev:chr_file rw_file_perms;
