diff --git a/system_prop.mk b/system_prop.mk
--- a/system_prop.mk
+++ b/system_prop.mk
@@ -37,3 +37,8 @@
 
 # HAL1 has no independent Camera2 torch API. Use the Camera1 preview fallback.
 PRODUCT_SYSTEM_PROPERTIES += ro.camera.legacy_torch=true
+
+# Keep recording color conversion out of the legacy Adreno GLES context.
+PRODUCT_SYSTEM_PROPERTIES += \
+    ro.surface_flinger.force_hwc_copy_for_virtual_displays=true \
+    persist.hwc.enable_vds=1
diff --git a/sepolicy/property_contexts b/sepolicy/property_contexts
--- a/sepolicy/property_contexts
+++ b/sepolicy/property_contexts
@@ -1 +1,3 @@
 ro.camera.legacy_torch u:object_r:exported_default_prop:s0 exact bool
+persist.hwc.enable_vds u:object_r:exported_default_prop:s0 exact bool
+persist.hwc.mdpcomp.enable u:object_r:exported_default_prop:s0 exact bool
