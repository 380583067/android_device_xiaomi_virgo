diff --git a/drm/Android.mk b/drm/Android.mk
new file mode 100644
index 0000000..9b69848
--- /dev/null
+++ b/drm/Android.mk
@@ -0,0 +1,14 @@
+# SPDX-License-Identifier: Apache-2.0
+LOCAL_PATH := $(call my-dir)
+include $(CLEAR_VARS)
+LOCAL_MODULE := libprotobuf-cpp-v29-virgo
+LOCAL_MODULE_CLASS := SHARED_LIBRARIES
+LOCAL_MODULE_SUFFIX := .so
+LOCAL_MODULE_STEM := libprotobuf-cpp-v29
+LOCAL_MULTILIB := 32
+LOCAL_VENDOR_MODULE := true
+LOCAL_PREBUILT_MODULE_FILE := hardware/lineage/compat/vndk/v29/arm/libprotobuf-cpp-lite.so
+# Preserve the historical ABI; the blob has its original generic SONAME.
+LOCAL_CHECK_ELF_FILES := false
+LOCAL_STRIP_MODULE := false
+include $(BUILD_PREBUILT)
diff --git a/rootdir/etc/init.virgo.fm.rc b/rootdir/etc/init.virgo.fm.rc
new file mode 100644
index 0000000..13048b4
--- /dev/null
+++ b/rootdir/etc/init.virgo.fm.rc
@@ -0,0 +1,7 @@
+# WCNSS FM firmware is part of the modem/WCNSS firmware image.
+# libfmjni's QCOM_NO_FM_FIRMWARE path signals these two lifecycle properties.
+on property:hw.fm.init=1
+    write /sys/module/radio_iris_transport/parameters/fmsmd_set 1
+
+on property:hw.fm.init=0
+    write /sys/module/radio_iris_transport/parameters/fmsmd_set 0
