diff --git a/BoardConfig.mk b/BoardConfig.mk
index 6444eaa..aabcf31 100644
--- a/BoardConfig.mk
+++ b/BoardConfig.mk
@@ -26,7 +26,7 @@ DEVICE_PATH := device/xiaomi/virgo
 TARGET_OTA_ASSERT_DEVICE := virgo,cancro
 
 # Display
-TARGET_SCREEN_DENSITY := 440
+TARGET_SCREEN_DENSITY := 400
 
 # The stock virgo rawprogram layout reserves exactly 32768 sectors (16 MiB)
 # for recovery. Keep the build guard at that physical partition size so the
@@ -39,7 +39,7 @@ BOARD_RECOVERYIMAGE_PARTITION_SIZE := 16777216
 BOARD_SYSTEMIMAGE_PARTITION_SIZE := 3221225472
 
 # Recovery uses its own resource density; this does not change Android's
-# 440-dpi display setting. The hdpi recovery assets keep the full recovery UI
+# 400-dpi display setting. The hdpi recovery assets keep the full recovery UI
 # while reducing its PNG payload enough for virgo's fixed 16-MiB partition.
 TARGET_RECOVERY_DENSITY := hdpi
 
@@ -70,3 +70,8 @@ TARGET_LIBINIT_DEFINES_FILE := $(DEVICE_PATH)/init/init_virgo.cpp
 TARGET_KERNEL_CLANG_COMPILE := false
 # Use the real GCC driver directly; its legacy wrapper requires /usr/bin/python.
 KERNEL_CC = CC=$(BUILD_TOP)/prebuilts/gcc/linux-x86/arm/arm-linux-androideabi-4.9/bin/real-arm-linux-androideabi-gcc
+
+# WCNSS uses the Qualcomm V4L2 FM driver.
+BOARD_HAVE_QCOM_FM := true
+# WCNSS integrates FM firmware; there is no external patch downloader.
+TARGET_QCOM_NO_FM_FIRMWARE := true
diff --git a/system_prop.mk b/system_prop.mk
index 503a168..ac59917 100644
--- a/system_prop.mk
+++ b/system_prop.mk
@@ -18,3 +18,8 @@ PRODUCT_PROPERTY_OVERRIDES += \
 PRODUCT_PROPERTY_OVERRIDES += \
     ro.telephony.default_network=20 \
     persist.radio.multisim.config=dsds
+
+# WCNSS does not implement Android's LE vendor scan-filter commands.
+PRODUCT_PROPERTY_OVERRIDES += \
+    bluetooth.core.le.vendor_capabilities.enabled=false \
+    persist.camera.hal1.nv12_venus=true
diff --git a/virgo.mk b/virgo.mk
index 447d93a..57b32a6 100644
--- a/virgo.mk
+++ b/virgo.mk
@@ -51,3 +51,15 @@ PRODUCT_PACKAGES += \
 PRODUCT_COPY_FILES += \
     $(DEVICE_PATH)/wifi/WCNSS_qcom_wlan_nv.bin:system/vendor/firmware/wlan/prima/WCNSS_qcom_wlan_nv.bin \
     $(DEVICE_PATH)/wifi/WCNSS_qcom_wlan_nv_x5gbl.bin:system/vendor/firmware/wlan/prima/WCNSS_qcom_wlan_nv_x5gbl.bin
+
+# Network validation URLs and the WCNSS FM application.
+PRODUCT_PACKAGES += \
+    VirgoNetworkStackOverlay \
+    FMRadio
+
+# The legacy Widevine engine needs protobuf v29, isolated from framework protobuf.
+PRODUCT_PACKAGES += libprotobuf-cpp-v29-virgo
+
+# Start and stop the in-kernel WCNSS FM SMD transport with the JNI lifecycle.
+PRODUCT_COPY_FILES += \
+    $(DEVICE_PATH)/rootdir/etc/init.virgo.fm.rc:$(TARGET_COPY_OUT_VENDOR)/etc/init/init.virgo.fm.rc
