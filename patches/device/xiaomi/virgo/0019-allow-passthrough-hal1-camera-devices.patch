diff --git a/sepolicy/cameraserver.te b/sepolicy/cameraserver.te
new file mode 100644
index 0000000..d0c7748
--- /dev/null
+++ b/sepolicy/cameraserver.te
@@ -0,0 +1,3 @@
+# Virgo runs its HAL1 provider in cameraserver (passthrough), rather than
+# in hal_camera_default. It opens the V4L2 camera nodes in that process.
+allow cameraserver video_device:chr_file rw_file_perms;
diff --git a/sepolicy/file_contexts b/sepolicy/file_contexts
index 15fdbf3..1c621ee 100644
--- a/sepolicy/file_contexts
+++ b/sepolicy/file_contexts
@@ -14,3 +14,10 @@
 /(vendor|system/vendor)/bin/hw/vendor\.lineage\.touch@1\.0-service\.virgo u:object_r:hal_lineage_touch_default_exec:s0
 # Legacy passthrough sensors: proximity, ALS, pressure, IMU, and activity.
 /dev/iio:device[0-4] u:object_r:virgo_sensor_device:s0
+# The HAL1 camera loads the legacy power module in cameraserver.
+/(vendor|system/vendor)/lib/hw/power\.default\.so u:object_r:same_process_hal_file:s0
+# HAL1 still-image encoder and its private JPEG dependencies.
+/(vendor|system/vendor)/lib/libqomx_jpegenc\.so u:object_r:same_process_hal_file:s0
+/(vendor|system/vendor)/lib/libmmqjpeg_codec\.so u:object_r:same_process_hal_file:s0
+/(vendor|system/vendor)/lib/libmmjpeg\.so u:object_r:same_process_hal_file:s0
+/(vendor|system/vendor)/lib/libjpegehw\.so u:object_r:same_process_hal_file:s0
