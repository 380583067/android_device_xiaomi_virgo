--- /dev/null
+++ b/sepolicy/touch.te
@@ -0,0 +1,3 @@
+# Give the Lineage touch HAL access to the capacitive-key enable switch.
+type virgo_touch_key_sysfs, fs_type, sysfs_type;
+allow hal_lineage_touch_default virgo_touch_key_sysfs:file rw_file_perms;
--- /dev/null
+++ b/sepolicy/power.te
@@ -0,0 +1,3 @@
+# power_set_interactive_ext() toggles these GPIO-key nodes on sleep/wake.
+type virgo_gpio_keys_sysfs, fs_type, sysfs_type;
+allow hal_power_default virgo_gpio_keys_sysfs:file rw_file_perms;
--- /dev/null
+++ b/sepolicy/sensors.te
@@ -0,0 +1,4 @@
+# Virgo's legacy sensors passthrough HAL runs inside system_server.
+# Label only this board's five IIO sensor devices for read-only acquisition.
+type virgo_sensor_device, dev_type;
+allow system_server virgo_sensor_device:chr_file r_file_perms;
