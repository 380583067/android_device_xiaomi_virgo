+
+static int writeLegacyCommand(const char* command) {
+    base::unique_fd fd(TEMP_FAILURE_RETRY(open("/proc/net/xt_qtaguid/ctrl",
+                                              O_WRONLY | O_CLOEXEC)));
+    if (fd.get() < 0) return -errno;
+    const size_t len = strlen(command);
+    const ssize_t written = TEMP_FAILURE_RETRY(write(fd.get(), command, len));
+    if (written < 0) return -errno;
+    return static_cast<size_t>(written) == len ? 0 : -EIO;
+}
+
+static jint nativeSetLegacyUidCounterSet(JNIEnv*, jclass, jint uid, jint set) {
+    if (uid < 0 || set < 0 || set > 1) return -EINVAL;
+    char command[64];
+    snprintf(command, sizeof(command), "s %d %d", set, uid);
+    return writeLegacyCommand(command);
+}
+
+static jint nativeDeleteLegacyUidStats(JNIEnv*, jclass, jint uid) {
+    if (uid < 0) return -EINVAL;
+    char command[64];
+    snprintf(command, sizeof(command), "d 0 %d", uid);
+    return writeLegacyCommand(command);
+}
