+// The non-BPF kernels used by older devices expose cumulative xt_qtaguid
+// counters. Keep the tag's upper 32 bits, matching NetworkStatsFactory.kernelToTag.
+static int readLegacyNetworkStats(std::vector<stats_line>& lines, bool detail) {
+    FILE* file = fopen(detail ? "/proc/net/xt_qtaguid/stats"
+                              : "/proc/net/xt_qtaguid/iface_stat_fmt", "re");
+    if (file == nullptr) return -1;
+    char buffer[1024];
+    while (fgets(buffer, sizeof(buffer), file) != nullptr) {
+        stats_line line = {};
+        uint32_t index;
+        uint64_t tag;
+        int matched;
+        if (detail) {
+            matched = sscanf(buffer, "%" SCNu32 " %31s 0x%" SCNx64 " %" SCNu32 " %" SCNu32
+                    " %" SCNd64 " %" SCNd64 " %" SCNd64 " %" SCNd64,
+                    &index, line.iface, &tag, &line.uid, &line.set,
+                    &line.rxBytes, &line.rxPackets, &line.txBytes, &line.txPackets);
+            if (matched != 9) continue; // includes the column header
+            line.tag = static_cast<uint32_t>(tag >> 32);
+        } else {
+            matched = sscanf(buffer, "%31s %" SCNd64 " %" SCNd64 " %" SCNd64 " %" SCNd64,
+                    line.iface, &line.rxBytes, &line.rxPackets, &line.txBytes, &line.txPackets);
+            if (matched != 5) continue;
+            line.uid = static_cast<uint32_t>(bpf::UID_ALL);
+            line.set = static_cast<uint32_t>(bpf::SET_ALL);
+        }
+        lines.push_back(line);
+    }
+    const int result = ferror(file) ? -1 : 0;
+    fclose(file);
+    return result;
+}
