 CompositionEngine::~CompositionEngine() = default;
 
+void presentLegacyOutputs(const CompositionRefreshArgs& args) {
+    for (const auto& output : args.outputs) {
+        output->updateColorProfile(args);
+        output->updateCompositionState(args);
+        output->planComposition();
+        output->writeCompositionState(args);
+        output->setColorTransform(args);
+        output->beginFrame();
+    }
+    for (const auto& output : args.outputs) {
+        output->prepareFrame();
+    }
+    for (const auto& output : args.outputs) {
+        output->devOptRepaintFlash(args);
+        output->finishFrame({});
+    }
+    for (const auto& output : args.outputs) {
+        output->presentFrameAndReleaseLayers();
+        output->renderCachedSets(args);
+    }
+}
