+#include <android/os/IPowerManager.h>
+#include <powermanager/LegacyPowerManager.h>
+
+#include <vector>
+
+namespace android {
+namespace {
+
+status_t legacyStatus(const binder::Status& status) {
+    if (status.isOk()) return OK;
+    return status.transactionError() != OK ? status.transactionError() : UNKNOWN_ERROR;
+}
+
+class LegacyPowerManager final : public BpInterface<IPowerManager> {
+public:
+    explicit LegacyPowerManager(const sp<IBinder>& binder)
+          : BpInterface<IPowerManager>(binder),
+            mService(interface_cast<os::IPowerManager>(binder)) {}
+
+    status_t acquireWakeLock(int flags, const sp<IBinder>& lock, const String16& tag,
+                            const String16& packageName) override {
+        // A negative work UID means the caller's UID, as with the old API's
+        // absent WorkSource. -1 is Display.INVALID_DISPLAY; no callback is used.
+        return acquireWakeLockWithUid(flags, lock, tag, packageName, -1);
+    }
+
+    status_t acquireWakeLockWithUid(int flags, const sp<IBinder>& lock, const String16& tag,
+                                   const String16& packageName, int uid) override {
+        return legacyStatus(mService->acquireWakeLockWithUid(lock, flags, tag, packageName,
+                                                           uid, -1, nullptr));
+    }
+
+    status_t releaseWakeLock(const sp<IBinder>& lock, int flags) override {
+        return legacyStatus(mService->releaseWakeLock(lock, flags));
+    }
+
+    status_t updateWakeLockUids(const sp<IBinder>& lock, int len, const int* uids) override {
+        if (len < 0 || (len > 0 && uids == nullptr)) return BAD_VALUE;
+        std::vector<int32_t> workUids;
+        if (len > 0) workUids.assign(uids, uids + len);
+        return legacyStatus(mService->updateWakeLockUids(lock, workUids));
+    }
+
+private:
+    const sp<os::IPowerManager> mService;
+};
+
+} // namespace
+
+IPowerManager::IPowerManager() = default;
+IPowerManager::~IPowerManager() = default;
+
+const String16& IPowerManager::getInterfaceDescriptor() const {
+    return os::IPowerManager::descriptor;
+}
+
+sp<IPowerManager> IPowerManager::asInterface(const sp<IBinder>& binder) {
+    if (binder == nullptr) return nullptr;
+    return sp<LegacyPowerManager>::make(binder);
+}
+
+} // namespace android
