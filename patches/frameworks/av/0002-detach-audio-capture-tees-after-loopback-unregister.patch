+TEST_F(AudioPolicyManagerTestDynamicPolicy, DetachCaptureTeeAfterInputStops) {
+    audio_port_handle_t deviceId = AUDIO_PORT_HANDLE_NONE;
+    audio_port_handle_t playbackPortId = AUDIO_PORT_HANDLE_NONE;
+    audio_attributes_t attr = AUDIO_ATTRIBUTES_INITIALIZER;
+    attr.usage = AUDIO_USAGE_MEDIA;
+    ASSERT_NO_FATAL_FAILURE(getOutputForAttr(&deviceId, AUDIO_FORMAT_PCM_16_BIT,
+            AUDIO_CHANNEL_OUT_STEREO, k48000SamplingRate, AUDIO_OUTPUT_FLAG_NONE,
+            nullptr /*output*/, &playbackPortId, attr));
+    ASSERT_EQ(NO_ERROR, mManager->startOutput(playbackPortId));
+
+    audio_config_t config = AUDIO_CONFIG_INITIALIZER;
+    config.sample_rate = k48000SamplingRate;
+    config.channel_mask = AUDIO_CHANNEL_OUT_STEREO;
+    config.format = AUDIO_FORMAT_PCM_16_BIT;
+    ASSERT_NO_FATAL_FAILURE(addPolicyMixAndStartInputForLoopback(MIX_TYPE_PLAYERS,
+            MIX_ROUTE_FLAG_LOOP_BACK_AND_RENDER, AUDIO_DEVICE_OUT_REMOTE_SUBMIX,
+            mMixAddress, config,
+            {AudioMixMatchCriterion(AUDIO_USAGE_MEDIA, AUDIO_SOURCE_DEFAULT,
+                    RULE_MATCH_ATTRIBUTE_USAGE)}));
+    ASSERT_TRUE(mClient->mSecondaryOutputUpdates.count(playbackPortId));
+    ASSERT_FALSE(mClient->mSecondaryOutputUpdates.at(playbackPortId).empty());
+
+    // AudioRecord.stop/release disconnects the submix before unregistering its policy.
+    ASSERT_EQ(NO_ERROR, mManager->stopInput(mLoopbackInputPortId));
+    mManager->releaseInput(mLoopbackInputPortId);
+    mLoopbackInputPortId = AUDIO_PORT_HANDLE_NONE;
+    mClient->mSecondaryOutputUpdates.clear();
+    ASSERT_EQ(NO_ERROR, mManager->unregisterPolicyMixes(mAudioMixes));
+    mAudioMixes.clear();
+    ASSERT_TRUE(mClient->mSecondaryOutputUpdates.count(playbackPortId));
+    EXPECT_TRUE(mClient->mSecondaryOutputUpdates.at(playbackPortId).empty());
+
+    EXPECT_EQ(NO_ERROR, mManager->stopOutput(playbackPortId));
+    mManager->releaseOutput(playbackPortId);
+}
+
 TEST_F(AudioPolicyManagerTestDynamicPolicy, InitSuccess) {
     // SetUp must finish with no assertions
 }
