+    private void maybeActivateLegacyUicc(IccCardStatus status, int phoneId, int slotId) {
+        if (!mLegacyUiccActivation) return;
+        if (status.mCardState == IccCardStatus.CardState.CARDSTATE_ABSENT) {
+            mLegacyUiccActivationRequested[phoneId] = false;
+            return;
+        }
+        if (status.mGsmUmtsSubscriptionAppIndex >= 0
+                || status.mCdmaSubscriptionAppIndex >= 0) {
+            // Do not undo a later explicit application disable on this card.
+            mLegacyUiccActivationRequested[phoneId] = true;
+            return;
+        }
+        if (status.mCardState != IccCardStatus.CardState.CARDSTATE_PRESENT
+                || mLegacyUiccActivationRequested[phoneId]
+                || mCis[phoneId].getRadioState() != TelephonyManager.RADIO_POWER_ON
+                || status.mApplications == null) {
+            return;
+        }
+        for (int appIndex = 0; appIndex < status.mApplications.length; appIndex++) {
+            IccCardApplicationStatus app = status.mApplications[appIndex];
+            if (app == null || (app.app_type != IccCardApplicationStatus.AppType.APPTYPE_SIM
+                    && app.app_type != IccCardApplicationStatus.AppType.APPTYPE_USIM)) {
+                continue;
+            }
+            // One request per card/radio lifetime: repeated ICC indications must
+            // not create a provisioning loop, including on unsupported RILs.
+            mLegacyUiccActivationRequested[phoneId] = true;
+            logWithLocalLog("Activating legacy UICC phoneId=" + phoneId + " slot="
+                    + slotId + " app=" + appIndex);
+            mCis[phoneId].setUiccSubscription(slotId, appIndex, phoneId, 1,
+                    obtainMessage(EVENT_LEGACY_UICC_ACTIVATION_DONE, phoneId));
+            return;
+        }
+    }
