+#include <errno.h>
+#include <poll.h>
+#include <signal.h>
+#include <sys/prctl.h>
+#include <sys/wait.h>
+#include <unistd.h>
+
+#include <chrono>
+#include <set>
+#include <sstream>
+#include <string>
+
+#include <android-base/file.h>
+#include <android-base/unique_fd.h>
+#include <gtest/gtest.h>
+#include <processgroup/processgroup.h>
+
+namespace {
+
+struct Children {
+    pid_t leader = -1;
+    pid_t escaped = -1;
+    ~Children() {
+        for (pid_t pid : {leader, escaped}) {
+            if (pid > 0) {
+                kill(pid, SIGKILL);
+                TEMP_FAILURE_RETRY(waitpid(pid, nullptr, 0));
+            }
+        }
+    }
+};
+
+void CheckLegacyCleanup(bool once) {
+    if (access("/sys/fs/cgroup/cgroup.controllers", F_OK) == 0) {
+        GTEST_SKIP() << "This regression exercises the legacy v1 fallback";
+    }
+    std::string root;
+    ASSERT_TRUE(CgroupGetControllerPath("cpuacct", &root));
+    ASSERT_EQ(0, access((root + "/cgroup.procs").c_str(), F_OK));
+    ASSERT_EQ(0, prctl(PR_SET_CHILD_SUBREAPER, 1));
+
+    int start_pipe[2], ready_pipe[2];
+    ASSERT_EQ(0, pipe(start_pipe));
+    android::base::unique_fd start_read(start_pipe[0]), start_write(start_pipe[1]);
+    ASSERT_EQ(0, pipe(ready_pipe));
+    android::base::unique_fd ready_read(ready_pipe[0]), ready_write(ready_pipe[1]);
+
+    Children children;
+    children.leader = fork();
+    ASSERT_GE(children.leader, 0);
+    if (children.leader == 0) {
+        alarm(10);  // Bound the lifetime even if a parent assertion fails.
+        if (setpgid(0, 0) != 0) _exit(1);
+        char start;
+        if (!android::base::ReadFully(start_read.get(), &start, 1)) _exit(2);
+        const pid_t descendant = fork();
+        if (descendant < 0) _exit(3);
+        if (descendant == 0) {
+            alarm(10);
+            // Escape the leader's POSIX process group. Only cgroup membership
+            // can find this descendant when the complete tree is terminated.
+            if (setsid() < 0) _exit(4);
+            const pid_t self = getpid();
+            if (!android::base::WriteFully(ready_write.get(), &self, sizeof(self))) _exit(5);
+        }
+        while (true) pause();
+    }
+
+    ASSERT_EQ(0, createProcessGroup(getuid(), children.leader));
+    ASSERT_TRUE(android::base::WriteFully(start_write.get(), "x", 1));
+    pollfd ready{ready_read.get(), POLLIN, 0};
+    ASSERT_EQ(1, TEMP_FAILURE_RETRY(poll(&ready, 1, 3000)));
+    ASSERT_TRUE(android::base::ReadFully(ready_read.get(), &children.escaped,
+                                        sizeof(children.escaped)));
+    ASSERT_GT(children.escaped, 0);
+    ASSERT_EQ(children.escaped, getpgid(children.escaped));
+
+    const std::string group = root + "/uid_" + std::to_string(getuid()) + "/pid_" +
+            std::to_string(children.leader);
+    std::string procs;
+    ASSERT_TRUE(android::base::ReadFileToString(group + "/cgroup.procs", &procs));
+    std::istringstream stream(procs);
+    std::set<pid_t> members;
+    for (pid_t pid; stream >> pid;) members.insert(pid);
+    EXPECT_EQ((std::set<pid_t>{children.leader, children.escaped}), members);
+
+    const auto start = std::chrono::steady_clock::now();
+    const int result = once ? killProcessGroupOnce(getuid(), children.leader, SIGKILL)
+                            : killProcessGroup(getuid(), children.leader, SIGKILL);
+    if (once) {
+        EXPECT_TRUE(result == 0 || (result == -1 && errno == EBUSY));
+        EXPECT_LT(std::chrono::steady_clock::now() - start, std::chrono::seconds(1));
+    } else {
+        EXPECT_EQ(0, result);
+        EXPECT_LT(std::chrono::steady_clock::now() - start, std::chrono::seconds(1));
+    }
+
+    for (pid_t pid : {children.leader, children.escaped}) {
+        int status = 0;
+        ASSERT_EQ(pid, TEMP_FAILURE_RETRY(waitpid(pid, &status, 0)));
+        ASSERT_TRUE(WIFSIGNALED(status));
+        EXPECT_EQ(SIGKILL, WTERMSIG(status));
+    }
+    const pid_t leader = children.leader;
+    children.leader = children.escaped = -1;
+    if (once && result != 0) {
+        // The one-pass API may return before the tasks have exited.
+        ASSERT_EQ(0, killProcessGroup(getuid(), leader, SIGKILL));
+    }
+    EXPECT_EQ(-1, access(group.c_str(), F_OK));
+    EXPECT_EQ(ENOENT, errno);
+}
+
+TEST(ProcessgroupLegacy, KillsEscapedDescendantAndRemovesGroup) {
+    CheckLegacyCleanup(false);
+}
+
+TEST(ProcessgroupLegacy, OnePassKillsEscapedDescendant) {
+    CheckLegacyCleanup(true);
+}
